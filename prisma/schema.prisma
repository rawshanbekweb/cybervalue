generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HtmlExam {
  id         String          @id @default(cuid())
  title      String
  minutes    Int             @default(45)
  version    Int             @default(1)
  closed     Boolean         @default(false)
  createdAt  DateTime        @default(now())
  candidates HtmlCandidate[]
}

model HtmlCandidate {
  id           String    @id @default(cuid())
  examId       String
  exam         HtmlExam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId    String
  name         String
  codeHash     String    @unique
  sessionHash  String?   @unique
  variant      Int
  startedAt    DateTime?
  deadline     DateTime?
  submittedAt  DateTime?
  finishReason String?
  revision     Int       @default(0)
  code         String    @default("") @db.Text
  answers      Json      @default("{}")
  explanations Json      @default("[\"\",\"\"]")
  signals      Json      @default("{\"hidden\":0,\"paste\":0,\"fullscreen\":0}")
  autoScore    Int?
  grading      Json?
  reviewScore  Int?
  reviewNote   String    @default("") @db.Text
  createdAt    DateTime  @default(now())

  @@unique([examId, studentId])
  @@index([examId, submittedAt])
}

enum ContentKind {
  PROJECT
  LAB
  RESEARCH
  CTF
  RESOURCE
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model User {
  id                String           @id @default(cuid())
  name              String
  email             String?          @unique
  passwordHash      String?
  // Two-factor authentication. Secrets are AES-GCM sealed with AUTH_SECRET;
  // recovery codes are SHA-256 hashes, removed when used.
  totpSecret        String?
  totpPendingSecret String?
  totpLastStep      Int?
  recoveryCodes     String[]         @default([])
  content           Content[]
  sessions          Session[]
  loginChallenges   LoginChallenge[]
  adminEvents       AdminEvent[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// A correct password with 2FA enabled opens a short-lived challenge; the
// session is created only after the second factor succeeds.
model LoginChallenge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  attempts  Int      @default(0)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Append-only record of security-relevant admin activity.
model AdminEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  client    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}

model Content {
  id             String            @id @default(cuid())
  kind           ContentKind
  slug           String            @unique
  title          String
  summary        String
  body           String            @db.Text
  seoTitle       String?
  seoDescription String?
  status         PublicationStatus @default(DRAFT)
  featured       Boolean           @default(false)
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  authorId       String
  author         User              @relation(fields: [authorId], references: [id])
  categoryId     String?
  category       Category?         @relation(fields: [categoryId], references: [id])
  tags           Tag[]
  related        Content[]         @relation("RelatedContent")
  relatedFrom    Content[]         @relation("RelatedContent")
  project        Project?
  lab            Lab?
  research       ResearchArticle?
  ctf            CTFEvent?
  resource       Resource?
  images         ContentImage[]

  @@index([status, publishedAt])
  @@index([kind, status, publishedAt])
  @@index([categoryId])
}

model Project {
  contentId              String   @id
  content                Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  problem                String   @db.Text
  objective              String   @db.Text
  architecture           String   @db.Text
  securityConsiderations String   @db.Text
  challenges             String   @db.Text
  solution               String   @db.Text
  result                 String   @db.Text
  lessonsLearned         String   @db.Text
  technologies           String[]
  repositoryUrl          String?
  liveUrl                String?
  projectStatus          String
}

model Lab {
  contentId      String     @id
  content        Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  environment    String
  objective      String     @db.Text
  tools          String[]
  methodology    String     @db.Text
  discovery      String     @db.Text
  analysis       String     @db.Text
  impact         String     @db.Text
  remediation    String     @db.Text
  lessonsLearned String     @db.Text
  difficulty     Difficulty
  authorized     Boolean    @default(false)
}

model ResearchArticle {
  contentId  String   @id
  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  references String[]
}

model CTFEvent {
  contentId        String   @id
  content          Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  eventName        String
  eventDate        DateTime
  location         String?
  placement        String?
  challengesSolved String[]
  categories       String[]
  lessonsLearned   String   @db.Text
}

model Resource {
  contentId String  @id
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  type      String
  filePath  String
  topic     String
  version   String
}

model Tag {
  id      String    @id @default(cuid())
  name    String
  slug    String    @unique
  content Content[]
}

model Category {
  id      String    @id @default(cuid())
  name    String
  slug    String    @unique
  content Content[]
}

model ContentImage {
  id        String  @id @default(cuid())
  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  path      String
  alt       String
  width     Int
  height    Int
  position  Int     @default(0)
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String   @unique
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoredFile {
  id        String   @id @default(cuid())
  path      String   @unique
  name      String
  kind      String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  data      Bytes
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

// Cybervalue Academy Junior members. They sign in with a short access code
// (only its digest is stored) and their progress is kept here, so teachers
// can follow it. `progress` holds the validated Junior state; `xp` is
// recomputed from it on every save for listing and ranking.
model JuniorMember {
  id           String          @id @default(cuid())
  name         String
  group        String          @default("")
  note         String          @default("") @db.Text
  codeHash     String          @unique
  active       Boolean         @default(true)
  expiresAt    DateTime?       @db.Timestamptz(3)
  codename     String          @default("")
  progress     Json            @default("{}")
  xp           Int             @default(0)
  lastLoginAt  DateTime?       @db.Timestamptz(3)
  lastActiveAt DateTime?       @db.Timestamptz(3)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     JuniorSession[]

  @@index([group])
  @@index([xp])
}

model JuniorSession {
  id        String       @id @default(cuid())
  memberId  String
  tokenHash String       @unique
  expiresAt DateTime     @db.Timestamptz(3)
  createdAt DateTime     @default(now())
  member    JuniorMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

// Site-wide values an admin edits from the CMS, keyed by name. "home-portrait"
// holds the particle points of the home page portrait.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// Fixed-window counters shared by every instance. `key` is a SHA-256 digest.
model RateLimitBucket {
  key       String   @id
  count     Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

// Private learning area. Students sign in at /student with an access code the
// admin hands out; only its SHA-256 digest is stored.
enum MaterialKind {
  LESSON
  LAB
  PRACTICE
  QUIZ
  CHALLENGE
}

model Student {
  id           String               @id @default(cuid())
  name         String
  group        String               @default("")
  // Set by the teacher after the entrance exam: beginner, intermediate or
  // advanced; "" until placed.
  level        String               @default("")
  note         String               @default("") @db.Text
  codeHash     String               @unique
  active       Boolean              @default(true)
  expiresAt    DateTime?            @db.Timestamptz(3)
  lastLoginAt  DateTime?            @db.Timestamptz(3)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  sessions     StudentSession[]
  submissions  StudentSubmission[]
  progress     StudentProgress[]
  quizStarts   StudentQuizStart[]
  certificates StudentCertificate[]
  checkpoints  StudentCheckpoint[]
  labProgress  StudentLabProgress[]
  // Particle points from the student's own photo ({ aspect, points }); the
  // photo itself is never stored.
  portrait     Json?

  @@index([group])
}

model StudentSession {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now())

  @@index([studentId])
}

// `groups` empty means every student; otherwise only students in a listed group.
// `quiz` holds QUIZ questions with their answer key and never reaches the browser.
// A CHALLENGE renders `artifact` per student; `secret` derives each student's
// flag and variant, so flags themselves are never stored.
model StudentMaterial {
  id           String              @id @default(cuid())
  slug         String              @unique
  kind         MaterialKind
  title        String
  summary      String              @default("")
  body         String              @default("") @db.Text
  quiz         Json?
  maxAttempts  Int                 @default(3)
  // QUIZ only: minutes from pressing "Start" to the deadline; 0 = no limit.
  timeLimit    Int                 @default(0)
  artifact     String              @default("") @db.Text
  artifactName String              @default("")
  // Markdown shown after the student answers: a solved or exhausted lab, or
  // the final quiz attempt. Never sent earlier.
  explanation  String              @default("") @db.Text
  secret       String?
  groups       String[]            @default([])
  // Empty means every level; otherwise only students placed at a listed one.
  levels       String[]            @default([])
  published    Boolean             @default(false)
  position     Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  submissions  StudentSubmission[]
  progress     StudentProgress[]
  quizStarts   StudentQuizStart[]

  @@index([published, kind, position])
}

// A practice answer (body, reviewed by the admin) or a graded quiz attempt.
model StudentSubmission {
  id         String          @id @default(cuid())
  studentId  String
  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  materialId String
  material   StudentMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  body       String          @default("") @db.Text
  answers    Json?
  score      Int?
  maxScore   Int?
  feedback   String          @default("") @db.Text
  reviewedAt DateTime?       @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  @@index([studentId, materialId])
  @@index([materialId, createdAt])
}

model StudentProgress {
  studentId   String
  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  materialId  String
  material    StudentMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  completedAt DateTime        @default(now()) @db.Timestamptz(3)

  @@id([studentId, materialId])
  @@index([materialId])
}

// The open attempt on a timed quiz. It is deleted when the attempt is
// submitted, or turned into a zero-score attempt once its deadline passes.
model StudentQuizStart {
  studentId  String
  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  materialId String
  material   StudentMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  startedAt  DateTime        @default(now()) @db.Timestamptz(3)

  @@id([studentId, materialId])
  @@index([materialId])
}

// A certificate the teacher issued. `code` is public and printed as a QR code
// that opens /sertifikat/<code>; name and title are copied at issue time, and
// the certificate outlives the student's account.
model StudentCertificate {
  id        String    @id @default(cuid())
  code      String    @unique
  studentId String?
  student   Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  name      String
  title     String
  level     String    @default("")
  issuedAt  DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  @@index([studentId])
}

// A graded lab checkpoint attempt. The seed rebuilds the exact questions; it
// is unique per student so a graded set cannot be resubmitted.
model StudentCheckpoint {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checkpoint String
  seed       Int
  score      Int
  total      Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([studentId, checkpoint, seed])
  @@index([checkpoint, createdAt])
}

// Completed lessons of an open lab (network, linux, html, security) for a
// signed-in student, mirrored from the browser so progress follows them.
model StudentLabProgress {
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lab       String
  lessons   Int[]
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@id([studentId, lab])
}

// A task the teacher sets for a group (or "" for every student) with a
// deadline. `target` names what counts as done: "material:<id>",
// "checkpoint:<id>" (passed) or "lab:<id>" (every lesson finished).
model StudentAssignment {
  id        String   @id @default(cuid())
  title     String
  note      String   @default("") @db.Text
  group     String   @default("")
  target    String
  dueAt     DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([group, dueAt])
  @@index([dueAt])
}

// A live quiz the teacher runs on the classroom screen. Players join from
// their phones with `code` and a name; the questions are a snapshot of a
// test, so editing the test later does not change a running game.
model LiveGame {
  id        String       @id @default(cuid())
  code      String
  title     String
  questions Json
  // lobby, question, reveal or finished.
  state     String       @default("lobby")
  current   Int          @default(-1)
  seconds   Int          @default(20)
  startedAt DateTime?    @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  endedAt   DateTime?    @db.Timestamptz(3)
  players   LivePlayer[]
  answers   LiveAnswer[]

  @@index([code, state])
  @@index([createdAt])
}

model LivePlayer {
  id        String       @id @default(cuid())
  gameId    String
  game      LiveGame     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name      String
  tokenHash String       @unique
  score     Int          @default(0)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  answers   LiveAnswer[]

  @@unique([gameId, name])
}

model LiveAnswer {
  gameId   String
  game     LiveGame   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId String
  player   LivePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  question Int
  choice   Int
  correct  Boolean
  points   Int
  ms       Int
  at       DateTime   @default(now()) @db.Timestamptz(3)

  @@id([playerId, question])
  @@index([gameId, question])
}
