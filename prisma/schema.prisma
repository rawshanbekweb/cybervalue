generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HtmlExam {
  id         String          @id @default(cuid())
  title      String
  minutes    Int             @default(45)
  version    Int             @default(1)
  closed     Boolean         @default(false)
  createdAt  DateTime        @default(now())
  candidates HtmlCandidate[]
}

model HtmlCandidate {
  id           String    @id @default(cuid())
  examId       String
  exam         HtmlExam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId    String
  // The student-area account, when the candidate was added from a group:
  // they start from their own page without typing the code.
  accountId    String?
  name         String
  codeHash     String    @unique
  sessionHash  String?   @unique
  variant      Int
  startedAt    DateTime?
  deadline     DateTime?
  submittedAt  DateTime?
  finishReason String?
  revision     Int       @default(0)
  code         String    @default("") @db.Text
  answers      Json      @default("{}")
  explanations Json      @default("[\"\",\"\"]")
  signals      Json      @default("{\"hidden\":0,\"paste\":0,\"fullscreen\":0}")
  autoScore    Int?
  grading      Json?
  reviewScore  Int?
  reviewNote   String    @default("") @db.Text
  createdAt    DateTime  @default(now())

  @@unique([examId, studentId])
  @@index([examId, submittedAt])
  @@index([accountId])
}

enum ContentKind {
  PROJECT
  LAB
  RESEARCH
  CTF
  RESOURCE
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model User {
  id                String           @id @default(cuid())
  name              String
  email             String?          @unique
  passwordHash      String?
  // Two-factor authentication. Secrets are AES-GCM sealed with AUTH_SECRET;
  // recovery codes are SHA-256 hashes, removed when used.
  totpSecret        String?
  totpPendingSecret String?
  totpLastStep      Int?
  recoveryCodes     String[]         @default([])
  // "owner" runs everything; "teacher" sees only the groups listed below.
  role              String           @default("owner")
  groups            String[]         @default([])
  // A switched-off account cannot sign in.
  active            Boolean          @default(true)
  content           Content[]
  sessions          Session[]
  loginChallenges   LoginChallenge[]
  adminEvents       AdminEvent[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// A correct password with 2FA enabled opens a short-lived challenge; the
// session is created only after the second factor succeeds.
model LoginChallenge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  attempts  Int      @default(0)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Append-only record of security-relevant admin activity.
model AdminEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  client    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}

model Content {
  id             String            @id @default(cuid())
  kind           ContentKind
  slug           String            @unique
  title          String
  summary        String
  body           String            @db.Text
  seoTitle       String?
  seoDescription String?
  status         PublicationStatus @default(DRAFT)
  featured       Boolean           @default(false)
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  authorId       String
  author         User              @relation(fields: [authorId], references: [id])
  categoryId     String?
  category       Category?         @relation(fields: [categoryId], references: [id])
  tags           Tag[]
  related        Content[]         @relation("RelatedContent")
  relatedFrom    Content[]         @relation("RelatedContent")
  project        Project?
  lab            Lab?
  research       ResearchArticle?
  ctf            CTFEvent?
  resource       Resource?
  images         ContentImage[]

  @@index([status, publishedAt])
  @@index([kind, status, publishedAt])
  @@index([categoryId])
}

model Project {
  contentId              String   @id
  content                Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  problem                String   @db.Text
  objective              String   @db.Text
  architecture           String   @db.Text
  securityConsiderations String   @db.Text
  challenges             String   @db.Text
  solution               String   @db.Text
  result                 String   @db.Text
  lessonsLearned         String   @db.Text
  technologies           String[]
  repositoryUrl          String?
  liveUrl                String?
  projectStatus          String
}

model Lab {
  contentId      String     @id
  content        Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  environment    String
  objective      String     @db.Text
  tools          String[]
  methodology    String     @db.Text
  discovery      String     @db.Text
  analysis       String     @db.Text
  impact         String     @db.Text
  remediation    String     @db.Text
  lessonsLearned String     @db.Text
  difficulty     Difficulty
  authorized     Boolean    @default(false)
}

model ResearchArticle {
  contentId  String   @id
  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  references String[]
}

model CTFEvent {
  contentId        String   @id
  content          Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  eventName        String
  eventDate        DateTime
  location         String?
  placement        String?
  challengesSolved String[]
  categories       String[]
  lessonsLearned   String   @db.Text
}

model Resource {
  contentId String  @id
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  type      String
  filePath  String
  topic     String
  version   String
}

model Tag {
  id      String    @id @default(cuid())
  name    String
  slug    String    @unique
  content Content[]
}

model Category {
  id      String    @id @default(cuid())
  name    String
  slug    String    @unique
  content Content[]
}

model ContentImage {
  id        String  @id @default(cuid())
  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  path      String
  alt       String
  width     Int
  height    Int
  position  Int     @default(0)
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String   @unique
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoredFile {
  id        String   @id @default(cuid())
  path      String   @unique
  name      String
  kind      String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  data      Bytes
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

// Cybervalue Academy Junior members. They sign in with a short access code
// (only its digest is stored) and their progress is kept here, so teachers
// can follow it. `progress` holds the validated Junior state; `xp` is
// recomputed from it on every save for listing and ranking.
model JuniorMember {
  id           String          @id @default(cuid())
  name         String
  group        String          @default("")
  note         String          @default("") @db.Text
  codeHash     String          @unique
  active       Boolean         @default(true)
  expiresAt    DateTime?       @db.Timestamptz(3)
  codename     String          @default("")
  progress     Json            @default("{}")
  xp           Int             @default(0)
  lastLoginAt  DateTime?       @db.Timestamptz(3)
  lastActiveAt DateTime?       @db.Timestamptz(3)
  // Opens the read-only progress page for parents: /report/<token>.
  reportToken  String?         @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     JuniorSession[]

  @@index([group])
  @@index([xp])
}

model JuniorSession {
  id        String       @id @default(cuid())
  memberId  String
  tokenHash String       @unique
  expiresAt DateTime     @db.Timestamptz(3)
  createdAt DateTime     @default(now())
  member    JuniorMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

// Site-wide values an admin edits from the CMS, keyed by name. "home-portrait"
// holds the particle points of the home page portrait.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// Fixed-window counters shared by every instance. `key` is a SHA-256 digest.
model RateLimitBucket {
  key       String   @id
  count     Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

// Private learning area. Students sign in at /student with an access code the
// admin hands out; only its SHA-256 digest is stored.
enum MaterialKind {
  LESSON
  LAB
  PRACTICE
  QUIZ
  CHALLENGE
}

model Student {
  id           String               @id @default(cuid())
  name         String
  group        String               @default("")
  // Set by the teacher after the entrance exam: beginner, intermediate or
  // advanced; "" until placed.
  level        String               @default("")
  note         String               @default("") @db.Text
  codeHash     String               @unique
  active       Boolean              @default(true)
  expiresAt    DateTime?            @db.Timestamptz(3)
  lastLoginAt  DateTime?            @db.Timestamptz(3)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  sessions     StudentSession[]
  submissions  StudentSubmission[]
  progress     StudentProgress[]
  quizStarts   StudentQuizStart[]
  certificates StudentCertificate[]
  checkpoints  StudentCheckpoint[]
  labProgress  StudentLabProgress[]
  // Particle points from the student's own photo ({ aspect, points }); the
  // photo itself is never stored.
  portrait     Json?
  // Opens the read-only progress page for parents: /report/<token>.
  reportToken  String?              @unique
  // XP carried over from Academy Junior, and the member it came from.
  bonusXp      Int                  @default(0)
  juniorId     String?              @unique
  linuxIpExam  LinuxIpAttempt?

  @@index([group])
}

model StudentSession {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now())

  @@index([studentId])
}

// `groups` empty means every student; otherwise only students in a listed group.
// `quiz` holds QUIZ questions with their answer key and never reaches the browser.
// A CHALLENGE renders `artifact` per student; `secret` derives each student's
// flag and variant, so flags themselves are never stored.
model StudentMaterial {
  id           String              @id @default(cuid())
  slug         String              @unique
  kind         MaterialKind
  title        String
  summary      String              @default("")
  body         String              @default("") @db.Text
  quiz         Json?
  maxAttempts  Int                 @default(3)
  // QUIZ only: minutes from pressing "Start" to the deadline; 0 = no limit.
  timeLimit    Int                 @default(0)
  artifact     String              @default("") @db.Text
  artifactName String              @default("")
  // Markdown shown after the student answers: a solved or exhausted lab, or
  // the final quiz attempt. Never sent earlier.
  explanation  String              @default("") @db.Text
  secret       String?
  groups       String[]            @default([])
  // Empty means every level; otherwise only students placed at a listed one.
  levels       String[]            @default([])
  published    Boolean             @default(false)
  position     Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  submissions  StudentSubmission[]
  progress     StudentProgress[]
  quizStarts   StudentQuizStart[]

  @@index([published, kind, position])
}

// A practice answer (body, reviewed by the admin) or a graded quiz attempt.
model StudentSubmission {
  id         String          @id @default(cuid())
  studentId  String
  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  materialId String
  material   StudentMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  body       String          @default("") @db.Text
  answers    Json?
  score      Int?
  maxScore   Int?
  feedback   String          @default("") @db.Text
  // The teacher asked for a better answer; the student hands in a new one.
  returned   Boolean         @default(false)
  reviewedAt DateTime?       @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  @@index([studentId, materialId])
  @@index([materialId, createdAt])
}

model StudentProgress {
  studentId   String
  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  materialId  String
  material    StudentMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  completedAt DateTime        @default(now()) @db.Timestamptz(3)

  @@id([studentId, materialId])
  @@index([materialId])
}

// The open attempt on a timed quiz. It is deleted when the attempt is
// submitted, or turned into a zero-score attempt once its deadline passes.
model StudentQuizStart {
  studentId  String
  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  materialId String
  material   StudentMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  startedAt  DateTime        @default(now()) @db.Timestamptz(3)

  @@id([studentId, materialId])
  @@index([materialId])
}

// One attempt per student at the Linux and IP exam (/resources/linux-ip-exam).
// The server keeps the clock and the answers; the student sees the result
// only after a teacher approves it. Deleting the row lets them sit it again.
model LinuxIpAttempt {
  id           String    @id @default(cuid())
  studentId    String    @unique
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt    DateTime  @default(now()) @db.Timestamptz(3)
  deadline     DateTime  @db.Timestamptz(3)
  // Saved as the student works, so a closed browser loses nothing.
  answers      Json      @default("{}")
  // Times the student left the exam window, as counted by the page.
  leaves       Int       @default(0)
  submittedAt  DateTime? @db.Timestamptz(3)
  // "submitted" or "timeout".
  finishReason String?
  // The automatic grading (LipResult) and its total.
  grading      Json?
  autoScore    Float?
  // The teacher's points for open questions: { o1: 2, … }.
  overrides    Json      @default("{}")
  finalScore   Float?
  note         String    @default("") @db.Text
  approvedAt   DateTime? @db.Timestamptz(3)
  approvedBy   String?

  @@index([submittedAt])
}

// A certificate the teacher issued. `code` is public and printed as a QR code
// that opens /sertifikat/<code>; name and title are copied at issue time, and
// the certificate outlives the student's account.
model StudentCertificate {
  id        String    @id @default(cuid())
  code      String    @unique
  studentId String?
  student   Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  name      String
  title     String
  level     String    @default("")
  issuedAt  DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  // Set for certificates the site issues by itself (see lib/student/awards),
  // so each one is issued once.
  rule      String?

  @@unique([studentId, rule])
  @@index([studentId])
}

// A graded lab checkpoint attempt. The seed rebuilds the exact questions; it
// is unique per student so a graded set cannot be resubmitted.
model StudentCheckpoint {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checkpoint String
  seed       Int
  score      Int
  total      Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([studentId, checkpoint, seed])
  @@index([checkpoint, createdAt])
}

// Completed lessons of an open lab (network, linux, html, security) for a
// signed-in student, mirrored from the browser so progress follows them.
model StudentLabProgress {
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lab       String
  lessons   Int[]
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@id([studentId, lab])
}

// A task the teacher sets for a group (or "" for every student) with a
// deadline. `target` names what counts as done: "material:<id>",
// "checkpoint:<id>" (passed) or "lab:<id>" (every lesson finished).
model StudentAssignment {
  id        String   @id @default(cuid())
  title     String
  note      String   @default("") @db.Text
  group     String   @default("")
  target    String
  dueAt     DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([group, dueAt])
  @@index([dueAt])
}

// A live quiz the teacher runs on the classroom screen. Players join from
// their phones with `code` and a name; the questions are a snapshot of a
// test, so editing the test later does not change a running game.
model LiveGame {
  id        String       @id @default(cuid())
  code      String
  title     String
  questions Json
  // lobby, question, reveal or finished.
  state     String       @default("lobby")
  current   Int          @default(-1)
  seconds   Int          @default(20)
  startedAt DateTime?    @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  endedAt   DateTime?    @db.Timestamptz(3)
  players   LivePlayer[]
  answers   LiveAnswer[]

  @@index([code, state])
  @@index([createdAt])
}

model LivePlayer {
  id        String       @id @default(cuid())
  gameId    String
  game      LiveGame     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name      String
  tokenHash String       @unique
  score     Int          @default(0)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  answers   LiveAnswer[]

  @@unique([gameId, name])
}

model LiveAnswer {
  gameId   String
  game     LiveGame   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId String
  player   LivePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  question Int
  choice   Int
  correct  Boolean
  points   Int
  ms       Int
  at       DateTime   @default(now()) @db.Timestamptz(3)

  @@id([playerId, question])
  @@index([gameId, question])
}

// A Telegram chat that receives notifications. `subject` names who it is
// for: "teacher:<userId>", "student:<id>", "parent:student:<id>" or
// "parent:junior:<id>".
model TelegramChat {
  id        String   @id @default(cuid())
  chatId    String
  subject   String
  name      String   @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([chatId, subject])
  @@index([subject])
}

// Notifications already sent, so a reminder goes out once even when the
// daily job runs again.
model NotificationLog {
  key    String   @id
  sentAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([sentAt])
}

// Errors from the server (instrumentation onRequestError) and from browsers
// (error boundaries), grouped by fingerprint so a repeat only bumps `count`.
model ErrorEvent {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  source      String
  message     String    @db.Text
  digest      String    @default("")
  path        String    @default("")
  route       String    @default("")
  stack       String    @default("") @db.Text
  count       Int       @default(1)
  firstAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastAt      DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt  DateTime? @db.Timestamptz(3)

  @@index([lastAt])
}

// Academy Kids (ages 7–10): game-hacking missions, signed in with an access
// code like Junior members. Progress is { done, best, code }, see
// src/lib/kids/progress.ts.
model KidsMember {
  id           String        @id @default(cuid())
  name         String
  group        String        @default("")
  note         String        @default("") @db.Text
  codeHash     String        @unique
  active       Boolean       @default(true)
  progress     Json          @default("{}")
  xp           Int           @default(0)
  // Opens the read-only progress page for parents: /report/<token>.
  reportToken  String?       @unique
  // The Academy Junior member this child moved on to.
  juniorId     String?       @unique
  lastLoginAt  DateTime?     @db.Timestamptz(3)
  lastActiveAt DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     KidsSession[]

  @@index([group])
  @@index([xp])
}

model KidsSession {
  id        String     @id @default(cuid())
  memberId  String
  tokenHash String     @unique
  expiresAt DateTime   @db.Timestamptz(3)
  createdAt DateTime   @default(now())
  member    KidsMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

// Deleted items are kept here for 30 days so they can be restored. `data` is a
// snapshot of the row and everything that was deleted with it; `files` lists
// uploads it uses, which stay protected while the item is in the trash.
model TrashItem {
  id          String   @id @default(cuid())
  kind        String
  label       String
  group       String   @default("")
  data        Json
  files       String[] @default([])
  deletedById String?
  deletedAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([deletedAt])
  @@index([group])
}

// One row per learner per day they were active (Tashkent date), so the
// analytics page can draw history for Academy Junior and Kids, whose saved
// progress keeps no dates. Students' history comes from their answers.
model ActivityDay {
  kind     String
  memberId String
  day      DateTime @db.Date
  events   Int      @default(1)

  @@id([kind, memberId, day])
  @@index([day])
}

// CTF Challenges: public players who sign up with an email and password.
// Separate from staff (User) and invited students (Student).
model CtfPlayer {
  id              String          @id @default(cuid())
  email           String          @unique
  // As typed, for display; usernameKey (lower case) keeps names unique.
  username        String
  usernameKey     String          @unique
  passwordHash    String
  emailVerifiedAt DateTime?       @db.Timestamptz(3)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  lastLoginAt     DateTime?       @db.Timestamptz(3)
  sessions        CtfSession[]
  tokens          CtfToken[]
  teamId          String?
  team            CtfTeam?        @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  captainOf       CtfTeam?        @relation("TeamCaptain")
  joinedTeamAt    DateTime?       @db.Timestamptz(3)
  entries         CtfEntrant[]
  solves          CtfSolve[]
  submissions     CtfSubmission[]

  @@index([createdAt])
  @@index([teamId])
}

// A team a player plays in; a player is in at most one team at a time. The
// invite code is shown to members, so it is stored as is; the captain can
// replace it.
model CtfTeam {
  id         String       @id @default(cuid())
  name       String
  nameKey    String       @unique
  inviteCode String       @unique
  captainId  String       @unique
  captain    CtfPlayer    @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: Restrict)
  members    CtfPlayer[]  @relation("TeamMembers")
  entries    CtfEntrant[]
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
}

// A competition. Challenges open at startsAt and flags are accepted until
// endsAt. A team or a single player registers as one entrant.
model CtfEvent {
  id                 String            @id @default(cuid())
  slug               String            @unique
  title              String
  summary            String            @default("")
  description        String            @default("") @db.Text
  startsAt           DateTime          @db.Timestamptz(3)
  endsAt             DateTime          @db.Timestamptz(3)
  // Registration closes at this time (null: when the competition ends).
  registrationEndsAt DateTime?         @db.Timestamptz(3)
  maxTeamSize        Int               @default(4)
  allowSolo          Boolean           @default(true)
  published          Boolean           @default(false)
  // From this time until the end the scoreboard shows the frozen standings.
  freezeAt           DateTime?         @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  challenges         CtfChallenge[]
  entrants           CtfEntrant[]
  announcements      CtfAnnouncement[]

  @@index([published, startsAt])
}

// One participant of a competition: a team, or a player on their own.
model CtfEntrant {
  id          String          @id @default(cuid())
  eventId     String
  event       CtfEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamId      String?
  // A deleted team keeps its results under the saved name.
  team        CtfTeam?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  playerId    String?
  player      CtfPlayer?      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  // The name shown on the scoreboard, kept when the team is renamed later.
  name        String
  banned      Boolean         @default(false)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  solves      CtfSolve[]
  submissions CtfSubmission[]
  unlocks     CtfHintUnlock[]
  awards      CtfAward[]

  @@unique([eventId, teamId])
  @@unique([eventId, playerId])
}

model CtfChallenge {
  id            String          @id @default(cuid())
  eventId       String
  event         CtfEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title         String
  category      String
  description   String          @default("") @db.Text
  // Hidden from players until this time (null: open from the start).
  releaseAt     DateTime?       @db.Timestamptz(3)
  // Opens only after the entrant solved this challenge (same competition).
  requiresId    String?
  requires      CtfChallenge?   @relation("ChallengeRequires", fields: [requiresId], references: [id], onDelete: SetNull)
  unlocks       CtfChallenge[]  @relation("ChallengeRequires")
  // Wrong answers allowed per entrant (0: unlimited).
  maxAttempts   Int             @default(0)
  // Dynamic scoring: worth initialPoints at first, falling to minimumPoints
  // after `decay` solves.
  initialPoints Int             @default(500)
  minimumPoints Int             @default(100)
  decay         Int             @default(20)
  visible       Boolean         @default(true)
  position      Int             @default(0)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  flags         CtfFlag[]
  files         CtfFile[]
  hints         CtfHint[]
  solves        CtfSolve[]
  submissions   CtfSubmission[]

  @@index([eventId, position])
}

// The accepted answers of a challenge. Only SHA-256 of a random salt and the
// normalised flag is stored, never the flag itself.
model CtfFlag {
  id            String       @id @default(cuid())
  challengeId   String
  challenge     CtfChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  salt          String
  hash          String
  caseSensitive Boolean      @default(true)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([challengeId])
}

// Challenge attachments, kept apart from the public file library.
model CtfFile {
  id          String       @id @default(cuid())
  challengeId String
  challenge   CtfChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  name        String
  size        Int
  data        Bytes
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([challengeId])
}

model CtfHint {
  id          String          @id @default(cuid())
  challengeId String
  challenge   CtfChallenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  text        String          @db.Text
  cost        Int             @default(0)
  position    Int             @default(0)
  unlocks     CtfHintUnlock[]

  @@index([challengeId])
}

model CtfHintUnlock {
  entrantId String
  entrant   CtfEntrant @relation(fields: [entrantId], references: [id], onDelete: Cascade)
  hintId    String
  hint      CtfHint    @relation(fields: [hintId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  @@id([entrantId, hintId])
}

model CtfSolve {
  id          String       @id @default(cuid())
  entrantId   String
  entrant     CtfEntrant   @relation(fields: [entrantId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   CtfChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  // Who typed the flag; null once that player deleted the account.
  playerId    String?
  player      CtfPlayer?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([entrantId, challengeId])
  @@index([challengeId, createdAt])
}

// Every flag attempt, for limits and for spotting shared flags. Only a
// digest of what was typed is kept.
model CtfSubmission {
  id          String       @id @default(cuid())
  entrantId   String
  entrant     CtfEntrant   @relation(fields: [entrantId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   CtfChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  playerId    String?
  player      CtfPlayer?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  correct     Boolean
  valueHash   String
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([entrantId, challengeId, createdAt])
  @@index([challengeId, valueHash])
}

// A manual score change by an organiser: a bonus (positive) or a penalty
// (negative), with the reason shown to the entrant.
model CtfAward {
  id        String     @id @default(cuid())
  entrantId String
  entrant   CtfEntrant @relation(fields: [entrantId], references: [id], onDelete: Cascade)
  points    Int
  reason    String
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  @@index([entrantId])
}

model CtfAnnouncement {
  id        String   @id @default(cuid())
  eventId   String
  event     CtfEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([eventId, createdAt])
}

model CtfSession {
  id        String    @id @default(cuid())
  playerId  String
  player    CtfPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([playerId])
}

// One-time links sent by email: VERIFY confirms the address, RESET sets a
// new password. Only a SHA-256 digest of the token is stored.
model CtfToken {
  id        String    @id @default(cuid())
  playerId  String
  player    CtfPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  kind      String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([playerId, kind])
}
