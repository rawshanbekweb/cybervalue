# Development works without a database. Set this before importing content.
DATABASE_URL=
# Required for a real deployment. Use the canonical HTTPS origin, no path.
SITE_URL=http://localhost:3000
# Explicit opt-in prevents a preview deployment from being indexed.
SITE_INDEXABLE=false
# Optional verified profile URLs; empty values hide the links.
GITHUB_URL=
LINKEDIN_URL=
TELEGRAM_URL=
INSTAGRAM_URL=
# Optional vulnerability report contact for /.well-known/security.txt,
# as mailto:you@example.com or an HTTPS URL. Empty disables the file.
SECURITY_CONTACT=
# Required to enable admin two-factor authentication (32+ random characters,
# e.g. `openssl rand -base64 32`). Keep it stable: rotating it disables 2FA.
AUTH_SECRET=
# Optional Telegram bot for reminders and parent reports (see docs/telegram.md).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Required by the daily reminder job (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
# Optional email for CTF Challenges (sign-up confirmation, password reset),
# sent through Resend (https://resend.com). EMAIL_FROM must be an address on a
# domain verified in Resend, e.g. "Cybervalue CTF <ctf@yourdomain.uz>".
# Without both, nothing is sent and the message is printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=
